{
  "name": "memo",
  "version": "0.1.1",
  "description": "Memo Desktop Application",
  "desktopName": "Memo",
  "homepage": "https://memocash.github.io/desktop/",
  "main": "main/index.js",
  "repository": "github.com/memocash/desktop",
  "scripts": {
    "prestart": "node scripts/build-preload.js",
    "start": "electron .",
    "test": "node --test \"main/**/*.test.js\" \"scripts/**/*.test.js\" \"renderer/**/*.test.js\"",
    "build": "node scripts/build-preload.js && node scripts/build-renderer.js",
    "pack-app": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "author": "Memo Technology, Inc.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "cash.memo.desktop",
    "productName": "Memo",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © Memo Technology, Inc.",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "files": [
      "main/**/*",
      "!main/**/*.test.js",
      "!main/common/bitcoin/golden.json",
      "!main/common/bitcoin/bip32_golden.json",
      "!main/app/v1_golden.json",
      "licenses/**/*",
      "LICENSE.md",
      "build/icon.png",
      "renderer/out/**/*",
      "package.json"
    ],
    "publish": null,
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Finance",
      "icon": "build/icon.png",
      "maintainer": "Memo Technology, Inc. <support@memo.cash>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "bip39": "^3.1.0",
    "linkify-it": "^6.1.0",
    "tiny-secp256k1": "^2.2.4",
    "tlds": "^1.261.0",
    "ws": "^8.21.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
